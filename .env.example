# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
#
# Prisma 7 does NOT load .env automatically — prisma7.config.ts does it
# explicitly via `import "dotenv/config"`. Next.js loads .env on its own.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Requires PostgreSQL 15+.
# The ?schema=public suffix is Prisma's; it selects the search_path.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/portfolio_dev?schema=public"

# Absolute origin of the deployed site, used for metadataBase so Open Graph and
# canonical URLs resolve. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Contact form (step 5). Without these the form still works: the message is
# persisted and the visitor is told delivery failed, rather than the submission
# being silently lost.
# ---------------------------------------------------------------------------

# Resend API key.
RESEND_API_KEY=""
# Sender must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="portfolio@example.com"
# Where notifications are delivered.
CONTACT_TO_EMAIL="you@example.com"

# Salt for hashing client IPs used in rate limiting. Set this in production:
# without it the hashes fall back to a known constant and could be brute-forced
# against the IPv4 space. Any long random string works.
CONTACT_IP_SALT=""

# ---------------------------------------------------------------------------
# Added in later steps.
# ---------------------------------------------------------------------------

# GitHub personal access token for the stats cron job (step 6).
# Needs no scopes for public data; the commit heatmap uses the GraphQL API,
# which requires a token even for public contribution counts.
# GITHUB_TOKEN=""
# GITHUB_USERNAME=""
