# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
#
# Prisma 7 does NOT load .env automatically — prisma7.config.ts does it
# explicitly via `import "dotenv/config"`. Next.js loads .env on its own.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Requires PostgreSQL 15+.
# The ?schema=public suffix is Prisma's; it selects the search_path.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/portfolio_dev?schema=public"

# Absolute origin of the deployed site, used for metadataBase so Open Graph and
# canonical URLs resolve. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Added in later steps — listed here so the full set is visible in one place.
# ---------------------------------------------------------------------------

# Resend API key for the contact form (step 5).
# RESEND_API_KEY=""
# Verified sender and recipient for contact-form mail (step 5).
# CONTACT_FROM_EMAIL=""
# CONTACT_TO_EMAIL=""

# GitHub personal access token for the stats cron job (step 6).
# Needs no scopes for public data; the commit heatmap uses the GraphQL API,
# which requires a token even for public contribution counts.
# GITHUB_TOKEN=""
# GITHUB_USERNAME=""
